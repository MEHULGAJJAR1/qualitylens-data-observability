# SQLite is used only when DATABASE_URL is not set. An explicit PostgreSQL URL is never
# silently replaced; connection failures are reported by /api/v1/health.
# DATABASE_URL=postgresql+psycopg://qualitylens:qualitylens@localhost:5432/qualitylens
# DATABASE_URL=sqlite:///./qualitylens.db

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
ALERT_QUALITY_THRESHOLD=80
NUMERIC_DRIFT_THRESHOLD=0.20
CATEGORICAL_DRIFT_THRESHOLD=0.10
MISSING_DRIFT_THRESHOLD=0.05

# SMTP is optional. Configure all required fields to attempt delivery.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=qualitylens@example.com
# SMTP_STARTTLS=true
# ALERT_EMAIL_TO=team@example.com
